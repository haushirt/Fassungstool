{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fassungstool",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fassung",
      "database_id": "2e0490ca-2b9d-40a7-a45c-a207a9447e91"
    }
  ],

  "triggers": { "crons": ["0 6 * * 5"] },

  "vars": {
    "ABSENDER": "gastronovi.com"
  }
}
